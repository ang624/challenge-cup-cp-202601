# Optional same-origin FastAPI base URL. Leave empty while Next.js serves the private snapshot API.
NEXT_PUBLIC_API_BASE_URL=

# Local development: point to the reviewed snapshot outside this public repository.
PLATFORM_SNAPSHOT_PATH=
PLATFORM_SNAPSHOT_HASH_PATH=

# Vercel production: create a private Blob store and upload the reviewed snapshot.
PLATFORM_SNAPSHOT_BLOB_PATH=v4/v4-snapshot.json
PLATFORM_SNAPSHOT_SHA256=replace-with-reviewed-snapshot-sha256
# BLOB_READ_WRITE_TOKEN is provisioned by Vercel. Never commit its real value.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-managed-token

# Public judge access. Set true only for a separate protected preview.
REQUIRE_ACCESS_CONTROL=false
APP_ACCESS_USERNAME=reviewer
APP_ACCESS_PASSWORD=replace-with-a-long-random-secret

# Visible in /api/health and deployment logs.
DEPLOYMENT_VERSION=local
